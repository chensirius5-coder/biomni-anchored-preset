# Copy this file to $BIOMNI_HOME/.env (default: ~/Biomni/.env) and fill in
# your provider values. Never commit a real .env file.

# Provider choice. Biomni supports OpenAI, AzureOpenAI, Anthropic, Ollama,
# Gemini, Bedrock, Groq, and any OpenAI-compatible Custom endpoint.
LLM_SOURCE=Custom
BIOMNI_SOURCE=Custom

# Model name, for example:
#   deepseek-v4-pro, gpt-4o, claude-sonnet-4-5, or your served model name
BIOMNI_LLM=deepseek-v4-pro

# OpenAI-compatible base URL and key. For OpenAI itself you can leave these
# empty and set LLM_SOURCE=OpenAI plus the usual OPENAI_API_KEY.
BIOMNI_CUSTOM_BASE_URL=https://api.deepseek.com/v1
BIOMNI_CUSTOM_API_KEY=

# Optional runtime controls.
BIOMNI_TIMEOUT_SECONDS=900
